# OpenShorts - GPU-first pipeline (template)
# Copy to .env and set your keys. System: CUDA auto-detected; see env_manager.py

DISABLE_YOUTUBE_URL=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_REFERER=http://localhost:5175
OPENROUTER_TITLE=OpenShorts Local

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
TRANSCRIBE_BACKEND=whisper
WHISPER_FORCE_GPU=1
ASR_GPU_CONCURRENCY=1

FFMPEG_ENCODER=nvenc
YOLO_DEVICE=cuda
TRANSNETV2_DEVICE=cuda

CLIP_WORKERS=2
MAX_CONCURRENT_JOBS=5

JOB_RETENTION_SECONDS=86400
OUTPUT_MAX_GB=25
UPLOADS_MAX_GB=15

BILLING_ENABLED=false
