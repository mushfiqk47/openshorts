# OpenShorts - GPU-first pipeline (template)
# Copy to .env and set your keys. System: CUDA auto-detected; see env_manager.py

DISABLE_YOUTUBE_URL=true
AI_PROVIDER=custom
AI_BASE_URL=https://circle-chamber-restructuring-protect.trycloudflare.com/v1
AI_API_KEY='sk-CIh1UZp58cOUvmjzzVZERR86wsi_Kt_F'
AI_MODEL=mimo-v2.6-heretic

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# Transcription runs NeMo-Speech.cpp (parakeet-tdt-0.6b-v3 GGUF) on CUDA
NEMO_ASR_MODEL='parakeet-tdt'
ASR_GPU_CONCURRENCY='4'

FFMPEG_ENCODER=nvenc
YOLO_DEVICE=cuda
TRANSNETV2_DEVICE=cuda

CLIP_WORKERS=2
MAX_CONCURRENT_JOBS=5

JOB_RETENTION_SECONDS=86400
OUTPUT_MAX_GB=25
UPLOADS_MAX_GB=15

BILLING_ENABLED=false

# Parked feature: SaaSShorts AI-UGC generator (dashboard tabs removed 2026-11-15).
# Set to true to mount /api/saasshorts/* plus the /gallery SEO pages again.
SAASSHORTS=false
