# --- OpenShorts â€” local clips-only + OpenRouter free model ---
# No YouTube automation: file uploads only. Clips pipeline + vertical reframe.

# Disable YouTube URL ingest (file uploads only)
DISABLE_YOUTUBE_URL=true

# OpenRouter (free tier) â€” paste your key from https://openrouter.ai/keys
# Free models don't need credits. Example: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=
# Default free model â€” updated 2026-08: many old :free are now paid-only
# Verified free now: z-ai/glm-5.2:free, nvidia/nemotron-nano-9b-v2:free, google/gemma-4-26b-a4b-it:free (rate-limited)
# dots-studio/dots-3-note-preview:free also free but often returns empty JSON for detail â€” z-ai is more reliable
OPENROUTER_MODEL=z-ai/glm-5.2:free
# Optional: which site to report as referer for OpenRouter rankings
OPENROUTER_REFERER=http://localhost:5175
OPENROUTER_TITLE=OpenShorts Local

# Fallback: if you prefer Gemini, set GEMINI_API_KEY instead (AIza...)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Whisper transcription â€” GPU-only (CUDA) as requested
# Uses RTX 4050 6GB: small + float16 is the stable default; turbo also fits (1.5GB)
# small/cuda/float16 ~2x faster than small/cpu/int8; no CPU fallback when cuda is set
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
TRANSCRIBE_BACKEND=whisper
# Force GPU only (no auto-fallback to CPU on VRAM error)
WHISPER_FORCE_GPU=1
ASR_GPU_CONCURRENCY=1

# Renderer
CLIP_WORKERS=2

# Retention (24h local, clips stay longer in output/)
JOB_RETENTION_SECONDS=86400
OUTPUT_MAX_GB=25
UPLOADS_MAX_GB=15

# No cloud billing locally
BILLING_ENABLED=false
