# OpenShorts - GPU-first pipeline (template)
# Copy to .env and set your keys. System: CUDA auto-detected; see env_manager.py

DISABLE_YOUTUBE_URL=true

# LLM Provider: Ollama (default) or any OpenAI-compatible base model (LM Studio, vLLM, LocalAI, etc.)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:1b
LLM_API_KEY=ollama

# Gemini fallback (optional)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Transcription: user-supplied file via --transcript (.srt/.vtt/.txt/.md/.json).
# Whisper auto-transcription was removed, so no WHISPER_* vars are read.

FFMPEG_ENCODER=nvenc
YOLO_DEVICE=cuda
TRANSNETV2_DEVICE=cuda

CLIP_WORKERS=2
MAX_CONCURRENT_JOBS=5

JOB_RETENTION_SECONDS=86400
OUTPUT_MAX_GB=25
UPLOADS_MAX_GB=15

BILLING_ENABLED=false
