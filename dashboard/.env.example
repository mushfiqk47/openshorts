# Dashboard (vite) env — copy to dashboard/.env and fill in.
# Vite loads this directory's .env for `npm run dev` and `npm run build`.

# Opt-in analytics (OpenPanel). Left empty, analytics stays fully inert:
# nothing is initialised and no request leaves the browser (see the
# analytics block in index.html for the second, hostname-based gate).
# VITE_OPENPANEL_API_URL=
# VITE_OPENPANEL_CLIENT_ID=
